{
  "manifest_version": 3,
  "name": "Naukri Automated Job Application",
  "version": "1.1.0",
  "description": "Intelligent autonomous job application assistant for Naukri.com with recruiter contact detection, experience matching, and smart auto-apply.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*.naukri.com/*",
    "https://naukri.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Naukri Automated Job Application Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.naukri.com/*",
        "https://naukri.com/*"
      ],
      "all_frames": false,
      "js": [
        "scripts/matcher.js",
        "scripts/form-filler.js",
        "scripts/applier.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/default_profile.json",
        "icons/*.png"
      ],
      "matches": [
        "https://*.naukri.com/*",
        "https://naukri.com/*"
      ]
    }
  ]
}
